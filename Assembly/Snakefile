            --threads {threads} 2>&1 | tee {log}
        """


# =============================================================================
# MAG QUALITY GATE (nanophase: completeness ≥50 %, contamination ≤10 %)
# =============================================================================

rule filter_mags:
    """
    Retain only MAGs with completeness >=50 % and contamination <=10 %
    (nanophase criterion). Filtered bins are copied to mags_filtered/.
    """
    input:
        checkm2_dir   = f"{ASSEMBLY_DIR}/{{barcode}}/checkm2_out",
        polished_bins = get_polished_bins
    output:
        mags_dir = directory(f"{ASSEMBLY_DIR}/{{barcode}}/mags_filtered")
    params:
        bins_dir = f"{ASSEMBLY_DIR}/{{barcode}}/bins_polished",
        report   = f"{ASSEMBLY_DIR}/{{barcode}}/checkm2_out/quality_report.tsv"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/filter_mags.log"
    threads: 1
    resources:
        mem_mb = 500
    shell:
        """
        mkdir -p {output.mags_dir}

        # CheckM2 quality_report.tsv: col1=Name  col2=Completeness  col3=Contamination
        awk -F'\\t' 'NR>1 && $2>=50 && $3<=10 {{print $1}}' {params.report} \
        | while read BIN; do
            SRC="{params.bins_dir}/${{BIN}}.fa"
            if [ -f "$SRC" ]; then
                cp "$SRC" {output.mags_dir}/
            fi
        done

        TOTAL=$(awk 'NR>1' {params.report} | wc -l)
        KEPT=$(find {output.mags_dir} -name '*.fa' 2>/dev/null | wc -l)
        echo "Total bins: $TOTAL  |  Passed (comp>=50, cont<=10): $KEPT" > {log}

        if [ "$KEPT" -eq 0 ]; then
            echo "WARNING: no MAGs passed quality filter" >> {log}
            touch {output.mags_dir}/NO_MAGS_PASSED
        fi
        """


# =============================================================================
# TAXONOMY — GTDB-Tk (on quality-filtered MAGs only)
# ==========================================================================
rule gtdbtk_classify:
    input:
        mags_dir = f"{ASSEMBLY_DIR}/{{barcode}}/mags_filtered"
    output:
        directory(f"{ASSEMBLY_DIR}/{{barcode}}/gtdbtk_out")
    conda:
        "gtdb"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/gtdbtk.log"
    threads: 30
    params:
        pplacer_cpus = 1
    shell:
        """
        if [ -f {input.mags_dir}/NO_MAGS_PASSED ]; then
            mkdir -p {output}
            echo "No MAGs passed quality filter - skipping GTDB-Tk" > {output}/SKIPPED.txt
            echo "No MAGs passed quality filter - skipping GTDB-Tk" > {log}
        else
            gtdbtk classify_wf \
                --genome_dir {input.mags_dir} \
                --out_dir {output} \
                --skip_ani_screen \
                --extension fa \
                --cpus {threads} \
                --pplacer_cpus {params.pplacer_cpus} 2>&1 | tee {log}
        fi
        """
