from glob import glob
import os

# =============================================================================
# CONFIGURATION
# =============================================================================

READS_DIR = "/mnt/workspace/petr/INTEC/PANGENOME/RAW_DATA/Run_5/fastq_pass"
ASSEMBLY_DIR = "/mnt/workspace/petr/INTEC/PANGENOME/ASSEMBLED/Run_5"

MEDAKA_MODEL = "r1041_e82_400bps_sup_v5.2.0"
MIN_CONTIG_LEN = 1500


BARCODES = [d for d in os.listdir(READS_DIR)
            if os.path.isdir(f"{READS_DIR}/{d}")
            and d.startswith("barcode")
            and 81 <= int(d.replace("barcode", "")) <= 90]

for barcode in BARCODES:
    os.makedirs(f"{ASSEMBLY_DIR}/{barcode}/logs", exist_ok=True)


# =============================================================================
# AGGREGATE HELPER — resolves bins after the DAS_tool checkpoint
# =============================================================================

def get_polished_bins(wildcards):
    """After DAS_tool finishes, discover bin names and request their polished versions."""
    bins_dir = checkpoints.DAS_tool.get(barcode=wildcards.barcode).output.bins_dir
    bin_names = glob_wildcards(os.path.join(bins_dir, "{b}.fa")).b
    return expand(
        f"{ASSEMBLY_DIR}/{wildcards.barcode}/bins_polished/{{b}}.fa",
        b=bin_names,
    )


# =============================================================================
# TARGET RULE
# =============================================================================

rule all:
    input:
        expand(f"{ASSEMBLY_DIR}/{{barcode}}/checkm2_out", barcode=BARCODES),
        expand(f"{ASSEMBLY_DIR}/{{barcode}}/mags_filtered", barcode=BARCODES),
        expand(f"{ASSEMBLY_DIR}/{{barcode}}/gtdbtk_out", barcode=BARCODES),
        expand(f"{ASSEMBLY_DIR}/{{barcode}}/quast_out", barcode=BARCODES),


# =============================================================================
# READ QC
# =============================================================================

rule read_qc:
    input:
        lambda wildcards: glob(f"{READS_DIR}/{wildcards.barcode}/*.fastq.gz")
    output:
        f"{ASSEMBLY_DIR}/{{barcode}}/reads_filtered.fastq.gz"
    conda:
        "chopper"
    params:
        reads_dir = lambda wildcards: f"{READS_DIR}/{wildcards.barcode}"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/read_qc.log"
    threads: 8
    resources:
        mem_mb = 2000
    shell:
        """
        for f in {params.reads_dir}/*.fastq.gz; do
            gunzip -c "$f" \
            | chopper --quality 10 --minlength 1000 --threads {threads} 2>> {log}
        done \
        | pigz -p 2 > {output}
        """

# =============================================================================
# ASSEMBLY (untouched)
# =============================================================================

rule metaMDBG:
    input:
        f"{ASSEMBLY_DIR}/{{barcode}}/reads_filtered.fastq.gz"
    output:
        f"{ASSEMBLY_DIR}/{{barcode}}/contigs.fasta.gz"
    conda:
        "nanoMDBG"
    params:
        outdir = f"{ASSEMBLY_DIR}/{{barcode}}"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/metaMDBG.log"
    threads: 20
    shell:
        """
        metaMDBG asm \
            --out-dir {params.outdir} \
            --in-ont {input} \
            --threads {threads} 2>&1 | tee {log}
        """


rule unzip_contigs:
    input:
        f"{ASSEMBLY_DIR}/{{barcode}}/contigs.fasta.gz"
    output:
        temp(f"{ASSEMBLY_DIR}/{{barcode}}/contigs.fasta")
    threads: 1
    resources:
        mem_mb = 500
    shell:
        "gunzip -c {input} > {output}"


# =============================================================================
# CONTIG FILTERING (takes raw assembly — no whole-assembly polishing)
# =============================================================================

rule filter_contigs:
    input:
        f"{ASSEMBLY_DIR}/{{barcode}}/contigs.fasta"
    output:
        f"{ASSEMBLY_DIR}/{{barcode}}/contigs.filt.fasta"
    params:
        min_len = MIN_CONTIG_LEN
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/filter_contigs.log"
    threads: 1
    resources:
        mem_mb = 500
    shell:
        """
        awk -v min={params.min_len} '
            /^>/ {{ if (seq != "" && length(seq) >= min) print header "\\n" seq; header=$0; seq="" }}
            !/^>/ {{ seq = seq $0 }}
            END {{ if (seq != "" && length(seq) >= min) print header "\\n" seq }}
        ' {input} > {output} 2> {log}
        """


# =============================================================================
# ASSEMBLY QC (on the bins)
# =============================================================================

rule quast:
    input:
        mags_dir = f"{ASSEMBLY_DIR}/{{barcode}}/mags_filtered"
    output:
        directory(f"{ASSEMBLY_DIR}/{{barcode}}/quast_out")
    conda:
        "quast"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/quast.log"
    threads: 4
    resources:
        mem_mb = 4000
    shell:
        """
        if [ -f {input.mags_dir}/NO_MAGS_PASSED ]; then
            mkdir -p {output}
            echo "No MAGs to evaluate" > {output}/SKIPPED.txt
        else
            BINS=$(find {input.mags_dir} -name '*.fa' | tr '\\n' ' ')
            quast $BINS \
                -o {output} \
                --threads {threads} \
                --min-contig 1000 \
                --split-scaffolds 2>&1 | tee {log}
        fi
        """

# =============================================================================
# READ MAPPING (whole-assembly; used by all three binners)
# =============================================================================

rule map_reads:
    input:
        contigs = f"{ASSEMBLY_DIR}/{{barcode}}/contigs.filt.fasta",
        reads = f"{ASSEMBLY_DIR}/{{barcode}}/reads_filtered.fastq.gz"
    output:
        bam = f"{ASSEMBLY_DIR}/{{barcode}}/alignments.sorted.bam"
    conda:
        "SemiBin"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/map_reads.log"
    threads: 16
    resources:
        mem_mb = 20000
    shell:
        """
        minimap2 -ax map-ont -t {threads} {input.contigs} {input.reads} \
        | samtools view -bS -@ 2 - \
        | samtools sort -@ 4 -m 1G -o {output.bam} 2> {log}
        """


rule index_bam:
    input:
        f"{ASSEMBLY_DIR}/{{barcode}}/alignments.sorted.bam"
    output:
        f"{ASSEMBLY_DIR}/{{barcode}}/alignments.sorted.bam.bai"
    conda:
        "SemiBin"
    threads: 2
    shell:
        "samtools index -@ {threads} {input}"


