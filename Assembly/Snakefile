rule SemiBin:
    input:
        contigs = f"{ASSEMBLY_DIR}/{{barcode}}/contigs.filt.fasta",
        bam = f"{ASSEMBLY_DIR}/{{barcode}}/alignments.sorted.bam",
        bai = f"{ASSEMBLY_DIR}/{{barcode}}/alignments.sorted.bam.bai"
    output:
        outdir = directory(f"{ASSEMBLY_DIR}/{{barcode}}/semibin_out")
    conda:
        "SemiBin"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/semibin.log"
    threads: 16
    resources:
        mem_mb = 15000
    shell:
        """
        SemiBin2 single_easy_bin --sequencing-type long_read \
            --self-supervised -i {input.contigs} -b {input.bam} \
            -o {output.outdir} 2>&1 | tee {log}
        """


rule preprocess_bins:
    input:
        semibin_dir = f"{ASSEMBLY_DIR}/{{barcode}}/semibin_out",
        contigs = f"{ASSEMBLY_DIR}/{{barcode}}/contigs.filt.fasta"
    output:
        contig_bins_noheader = temp(f"{ASSEMBLY_DIR}/{{barcode}}/semibin_contig_bins.noheader.tsv"),
        contigs_clean = temp(f"{ASSEMBLY_DIR}/{{barcode}}/contigs.clean.fasta")
    params:
        semibin_tsv = f"{ASSEMBLY_DIR}/{{barcode}}/semibin_out/contig_bins.tsv"
    threads: 1
    resources:
        mem_mb = 500
    shell:
        """
        tail -n +2 {params.semibin_tsv} | awk '$2 != -1' > {output.contig_bins_noheader}
        awk '/^>/ {{print $1}} !/^>/ {{print}}' {input.contigs} > {output.contigs_clean}
        """


