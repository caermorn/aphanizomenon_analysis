checkpoint DAS_tool:
    input:
        comebin_bins = f"{ASSEMBLY_DIR}/{{barcode}}/comebin_out",
        semibin_bins = f"{ASSEMBLY_DIR}/{{barcode}}/semibin_contig_bins.noheader.tsv",
        metabat_bins = f"{ASSEMBLY_DIR}/{{barcode}}/metabat_contig2bin_fixed.tsv",
        contigs = f"{ASSEMBLY_DIR}/{{barcode}}/contigs.clean.fasta"
    output:
        bins_dir = directory(f"{ASSEMBLY_DIR}/{{barcode}}/DAS_tool_out/DAS_tool_DASTool_bins")
    conda:
        "DAS_tool"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/DAS_tool.log"
    threads: 16
    resources:
        mem_mb = 15000
    params:
        comebin_tsv = f"{ASSEMBLY_DIR}/{{barcode}}/comebin_out/comebin_res/comebin_res.tsv",
        output_prefix = f"{ASSEMBLY_DIR}/{{barcode}}/DAS_tool_out/DAS_tool",
        output_dir = f"{ASSEMBLY_DIR}/{{barcode}}/DAS_tool_out"
    shell:
        """
        mkdir -p {params.output_dir}
        DAS_Tool \
            -i {params.comebin_tsv},{input.semibin_bins},{input.metabat_bins} \
            -l comebin,semibin,metabat \
            -c {input.contigs} \
            -o {params.output_prefix} \
            --threads {threads} \
            --write_bins 2>&1 | tee {log}
        """


# =============================================================================
# PER-BIN READ EXTRACTION (nanophase: ≥90 % identity AND ≥90 % query coverage)
# =============================================================================

rule extract_bin_reads:
    """
    Extract reads for a single bin from the existing whole-assembly BAM.
    Uses contig names in the bin FASTA to pull mapped reads, then filters
    for >=90% identity and >=90% query coverage.
    """
    input:
        bin_fa = f"{ASSEMBLY_DIR}/{{barcode}}/DAS_tool_out/DAS_tool_DASTool_bins/{{bin}}.fa",
        bam    = f"{ASSEMBLY_DIR}/{{barcode}}/alignments.sorted.bam",
        bai    = f"{ASSEMBLY_DIR}/{{barcode}}/alignments.sorted.bam.bai"
    output:
        reads = temp(f"{ASSEMBLY_DIR}/{{barcode}}/bin_reads/{{bin}}.fastq.gz")
    conda:
        "SemiBin"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/extract_reads_{{bin}}.log"
    threads: 2
    resources:
        mem_mb = 4000
    shell:
        """
        mkdir -p $(dirname {output.reads})

        # Step 1: get contig names from this bin
        CONTIGS=$(grep '^>' {input.bin_fa} | sed 's/^>//' | tr '\\n' ' ')

        # Step 2: extract reads mapped to those contigs
        # Step 3: filter for >=90% identity and >=90% query coverage
        samtools view -h {input.bam} $CONTIGS \
        | awk -F'\\t' '
            /^@/ {{print; next}}
            {{
                # query length
                qlen = length($10)
                if (qlen == 0) next

                # NM tag
                nm = 0
                for (i=12; i<=NF; i++)
                    if ($i ~ /^NM:i:/) {{split($i, a, ":"); nm = a[3]+0}}

                # aligned query bases from CIGAR (M + I + = + X consume query)
                cigar = $6; qal = 0; num = ""
                for (c=1; c<=length(cigar); c++) {{
                    ch = substr(cigar, c, 1)
                    if (ch ~ /[0-9]/) {{num = num ch}}
                    else {{
                        if (ch == "M" || ch == "I" || ch == "=" || ch == "X")
                            qal += num + 0
                        num = ""
                    }}
                }}

                # alignment block length (M + I + D + = + X)
                cigar2 = $6; alen = 0; num = ""
                for (c=1; c<=length(cigar2); c++) {{
                    ch = substr(cigar2, c, 1)
                    if (ch ~ /[0-9]/) {{num = num ch}}
                    else {{
                        if (ch == "M" || ch == "I" || ch == "D" || ch == "=" || ch == "X")
                            alen += num + 0
                        num = ""
                    }}
                }}

                identity = (alen > 0) ? (alen - nm) / alen : 0
                coverage = qal / qlen

                if (identity >= 0.90 && coverage >= 0.90) print
            }}
        ' \
        | samtools view -b \
        | samtools sort -n -@ {threads} \
        | samtools fastq -@ {threads} - 2>> {log} \
        | gzip > {output.reads}

        NREADS=$(zcat {output.reads} | awk 'NR%4==1' | wc -l)
        echo "Bin {wildcards.bin}: $NREADS reads passing 90%%/90%% filter" >> {log}
        """

# =============================================================================
# PER-BIN POLISHING — RACON (1 round, nanophase recommendation)
# =============================================================================

rule racon_polish_bin:
    """One round of Racon polishing per bin. Falls back to unpolished bin on failure."""
    input:
        bin_fa = f"{ASSEMBLY_DIR}/{{barcode}}/DAS_tool_out/DAS_tool_DASTool_bins/{{bin}}.fa",
        reads  = f"{ASSEMBLY_DIR}/{{barcode}}/bin_reads/{{bin}}.fastq.gz"
    output:
        polished = temp(f"{ASSEMBLY_DIR}/{{barcode}}/bins_racon/{{bin}}.fa")
    conda:
        "racon"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/racon_{{bin}}.log"
    threads: 4
    resources:
        mem_mb = 8000
    shell:
        """
        mkdir -p $(dirname {output.polished})

        SAM=$(mktemp {ASSEMBLY_DIR}/{wildcards.barcode}/bins_racon/.racon_XXXXXX.sam)
        trap 'rm -f "$SAM"' EXIT

        minimap2 -ax map-ont -t {threads} \
            {input.bin_fa} {input.reads} > "$SAM" 2> {log}

        racon {input.reads} "$SAM" {input.bin_fa} \
            -t {threads} > {output.polished} 2>> {log} \
        || {{
            echo "[racon] polishing failed for {wildcards.bin}; using unpolished bin" >> {log}
            cp {input.bin_fa} {output.polished}
        }}
        """


# =============================================================================
# PER-BIN POLISHING — MEDAKA (1 round, nanophase recommendation)
# =============================================================================

rule medaka_polish_bin:
    """One round of Medaka consensus polishing per bin. Falls back to racon output on failure."""
    input:
        bin_fa = f"{ASSEMBLY_DIR}/{{barcode}}/bins_racon/{{bin}}.fa",
        reads  = f"{ASSEMBLY_DIR}/{{barcode}}/bin_reads/{{bin}}.fastq.gz"
    output:
        polished = f"{ASSEMBLY_DIR}/{{barcode}}/bins_polished/{{bin}}.fa"
    conda:
        "medaka"
    log:
        f"{ASSEMBLY_DIR}/{{barcode}}/logs/medaka_{{bin}}.log"
    threads: 4
    resources:
        mem_mb = 12000
    params:
        outdir = f"{ASSEMBLY_DIR}/{{barcode}}/medaka_bins/{{bin}}",
        model  = MEDAKA_MODEL
    shell:
        """
        mkdir -p $(dirname {output.polished})

        medaka_consensus \
            -i {input.reads} \
            -d {input.bin_fa} \
            -o {params.outdir} \
            -m {params.model} \
            -t {threads} 2>&1 | tee {log} \
        && cp {params.outdir}/consensus.fasta {output.polished} \
        || {{
            echo "[medaka] polishing failed for {wildcards.bin}; using racon output" >> {log}
            cp {input.bin_fa} {output.polished}
        }}
        """


